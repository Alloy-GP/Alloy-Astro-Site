/* Add to src/styles/mobile.css (existing breakpoints: 980 / 720 / 480) */
@media (max-width: 720px) {
  .hero-card { padding: 22px !important; border-radius: 20px !important; gap: 18px !important; }
  .hero-card-h2 { font-size: 26px !important; }
  .hero-card-payoff { font-size: 20px !important; }
  .hero-card-avail { grid-template-columns: 1fr !important; gap: 20px !important; padding: 20px !important; }   /* guarantee lands under the CTA */
  .hero-card-avail-h { font-size: 20px !important; }
  .hero-card-guarantee { border-left: none !important; padding-left: 0 !important; border-top: 1px solid #ddd6e6; padding-top: 20px; }
  .hero-card-badge { width: 52px !important; height: 52px !important; }
}
/* Hover states (brand) */
.hero-card-form button:hover { background: #c12a60 !important; }
.hero-card-form button:active { background: #a82451 !important; transform: translateY(1px); }
.hero-card-guarantee a:hover { color: #d9356e !important; }
.hero-card input:focus-visible, .hero-card button:focus-visible, .hero-card a:focus-visible { outline: 2px solid #d9356e; outline-offset: 2px; }
