---
// src/components/sections/HeroStatic.astro
// Homepage hero — the hero card IS the hero (client, 2026-10-01: banner copy + layout removed).
// Static HTML wrapper so the card's H1 paints at HTML parse time (LCP); the card itself is a static
// React component and only its availability check hydrates.
//
// Usage (src/pages/index.astro):
//   <HeroStatic><HeroCard><MetroCheck client:load /></HeroCard></HeroStatic>
---
<section class="rd-page rd-section rd-section--hero rd-hero">
  <div class="rd-wrap">
    <slot />
  </div>
</section>
