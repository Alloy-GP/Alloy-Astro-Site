---
// src/components/sections/HeroStatic.astro
// Homepage hero wrapper — the HeroMap (option 7a, 2026-10-02) IS the hero. Static HTML so the H1 paints
// at HTML parse time (LCP); HeroMap is a static React component and only its metro check hydrates.
//
// Usage (src/pages/index.astro):
//   <HeroStatic><HeroMap><MetroCheck client:load /></HeroMap></HeroStatic>
---
<section class="rd-page rd-section rd-section--hero rd-hero">
  <div class="rd-wrap">
    <slot />
  </div>
</section>
