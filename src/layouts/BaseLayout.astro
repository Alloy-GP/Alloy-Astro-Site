---
// src/layouts/BaseLayout.astro
// Single layout for every Alloy page. All SEO defaults pulled from
// src/config/site.ts - never hardcode site name, OG image path, or
// twitter handle in page files.
//
// Usage (minimal):
//   <BaseLayout title="…" description="…" pageId="services">
//     …page sections…
//   </BaseLayout>
//
// Usage (article with custom OG image + schema):
//   <BaseLayout
//     title="…"
//     description="…"
//     pageId="resources"
//     ogType="article"
//     ogImage="/assets/og/my-article.png"
//     pageSchema={articleSchema}
//   >
//     …
//   </BaseLayout>
//
// Usage (noindex):
//   <BaseLayout title="…" description="…" robots="noindex,nofollow">

import '../styles/colors_and_type.css';
import '../styles/site.css';
import '../styles/chrome.css';
import '../styles/redesign.css';
import '../styles/mobile.css';

import SpeedInsights from '@vercel/speed-insights/astro';
import SiteHeader from '../components/chrome/SiteHeader.tsx';
import SiteFooter from '../components/chrome/SiteFooter.tsx';
import { SITE } from '../config/site.ts';

interface Props {
  /** <title> tag. Keep ≤ 60 chars for clean SERP display. Required. */
  title: string;

  /** Meta description. Keep 120–160 chars. Required. */
  description: string;

  /**
   * Which top-level nav item highlights as active.
   * Values: home | about | services | boardsuite | approach | resources
   * Pass null/undefined to leave nothing highlighted.
   */
  pageId?: string | null;

  /**
   * Header visual theme. Defaults to 'light'.
   * Use 'purple' on interior pages whose hero starts on a light background.
   */
  headerTheme?: 'light' | 'purple';

  /**
   * Disable the animated 5-color accent bar at the top of the footer.
   * Defaults to true (enabled).
   */
  animatedBar?: boolean;

  /**
   * Hide the global SiteHeader entirely (e.g. course lesson/quiz pages
   * that ship their own contextual topbar).
   */
  hideHeader?: boolean;

  /**
   * Hide the global SiteFooter entirely (e.g. focused landing pages that
   * ship their own minimal, low-distraction footer).
   */
  hideFooter?: boolean;

  /**
   * og:type. Defaults to 'website'. Use 'article' for resource hub articles.
   */
  ogType?: 'website' | 'article';

  /**
   * Per-page OG image. Absolute path from /public, e.g. "/assets/og/my-page.png".
   * Defaults to SITE.defaultOgImage (/assets/alloy-og.png).
   * Image must be 1200×630px PNG.
   */
  ogImage?: string;

  /**
   * robots meta content. Omit entirely for normal indexed pages.
   * Use "noindex,nofollow" for thank-you pages, staging, legal utilities, etc.
   * Use "noindex,follow" to allow link-following without indexing.
   */
  robots?: string;

  /**
   * Page-specific JSON-LD schema object(s) injected alongside the base
   * Organization schema. Pass a single object or an array.
   * E.g. FAQPage schema, Article schema, Service schema.
   */
  pageSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  pageId = null,
  headerTheme = 'light',
  animatedBar = true,
  hideHeader = false,
  hideFooter = false,
  ogType = 'website',
  ogImage: ogImageProp,
  robots,
  pageSchema,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
// Mobile sticky "Claim your market" bar (mobile-spec.md frame 1b): every chrome page except the form page (/contact).
const showStickyCta = !hideHeader && !hideFooter && !/^\/contact\/?$/.test(Astro.url.pathname);

// Staging / preview safety net: every non-production deployment (Vercel sets VERCEL_ENV to
// "preview" for branch deploys such as stg.alloygp.co) is noindex,nofollow so Google never
// indexes a duplicate of the site. Production (VERCEL_ENV=production) keeps per-page `robots`.
const vercelEnv = import.meta.env.VERCEL_ENV ?? process.env.VERCEL_ENV;
const isPreviewDeploy = !!vercelEnv && vercelEnv !== 'production';
const robotsContent = isPreviewDeploy ? 'noindex,nofollow' : robots;
// WebSite entity (site name + alternate name for Google's site-name display; emitted with the org on every page)
const websiteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, alternateName: 'Alloy', url: SITE.url + '/', inLanguage: 'en-US', publisher: { '@type': SITE.org.type, name: SITE.name, url: SITE.url } };

// Resolve OG image to absolute URL - use page override if provided, else default
const resolvedOgImage = new URL(
  ogImageProp ?? SITE.defaultOgImage,
  Astro.site ?? SITE.url
).toString();

const orgLd = {
  '@context': 'https://schema.org',
  '@type': SITE.org.type,
  name: SITE.name,
  url: SITE.url,
  logo: SITE.org.logo,
  sameAs: SITE.org.sameAs,
  description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.org.addressLocality,
    addressRegion: SITE.org.addressRegion,
    addressCountry: SITE.org.addressCountry,
  },
  telephone: SITE.org.telephone,
  email: SITE.org.email,
  areaServed: SITE.org.areaServed,
  priceRange: SITE.org.priceRange,
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- Favicons: ICO + 48/96px PNG for search engines (Google wants a stable PNG/ICO in 48px multiples; SVG support is
         patchy), SVG for modern tabs. Generated by .context/gen-favicons.mjs from assets/alloy-icon-1500.png. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/svg+xml" href="/assets/alloy-logomark.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#381c4f" />

    <!-- Robots (only emitted when explicitly set - absence = index,follow) -->
    {robotsContent && <meta name="robots" content={robotsContent} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:type" content={/\.jpe?g$/i.test(resolvedOgImage) ? 'image/jpeg' : /\.webp$/i.test(resolvedOgImage) ? 'image/webp' : 'image/png'} />
    <meta property="og:image:width" content={SITE.ogImageWidth} />
    <meta property="og:image:height" content={SITE.ogImageHeight} />
    <meta property="og:image:alt" content={`${SITE.name}. The growth system for CAM companies`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={`${SITE.name}. The growth system for CAM companies`} />

    <!-- Fonts: preload Book (400) and Bold (700) - the two weights used for body copy and
         UI elements above the fold. Gotham-Black (800) is intentionally NOT preloaded:
         display-xxl uses font-display:optional, and Chrome extends optional's block period
         to wait for any preloaded font. Without the preload, optional falls back at ~100ms
         consistently regardless of network speed, giving predictable LCP timing. -->
    <!-- WOFF2 is ~30% smaller than OTF; OTF is the fallback for any browser that needs it (none in 2026) -->
    <link rel="preload" href="/fonts/Gotham-Book.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Gotham-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <!-- No Google Fonts: Manrope/Sora unused in CSS; Gotham is self-hosted; system fonts cover the swap period -->

    <!-- No manual critical CSS block needed - build.inlineStylesheets:'always' in astro.config.mjs
         causes Astro to embed all CSS as inline <style> tags, eliminating the render-blocking
         external stylesheet entirely. The font preloads below give WOFF2 downloads a head start
         before the inlined @font-face declarations are parsed. -->

    <!-- Preconnect for conversion tracking domains - establishes connections early for post-load script -->
    <link rel="dns-prefetch" href="//s.ksrndkehqnwntyxlhgto.com" />

    <!-- JSON-LD: Organization (every page) -->
    <script type="application/ld+json" set:html={JSON.stringify([orgLd, websiteLd])} />
    <!-- JSON-LD: Page-specific schema (optional) -->
    {pageSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    )}

    <!-- Google Analytics: deferred to after page paint - eliminates forced reflow from gtag.js.
         dataLayer + gtag() are set up inline so any early gtag() calls on the page don't throw.
         The actual gtag/js script loads after the load event fires (same pattern as conversion tracking). -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0FSCT09DV7');
      window.addEventListener('load', function() {
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-0FSCT09DV7';
        document.head.appendChild(s);
      });
    </script>

    <!-- Conversion tracking: capture page data immediately, load external script after browser idle.
         Using requestIdleCallback (with setTimeout fallback) keeps the forced reflow from the
         tracking script off the main thread during page load, removes it from TBT entirely. -->
    <script is:inline>
      var $wc_load = function(a) { return JSON.parse(JSON.stringify(a)); };
      var $wc_leads = $wc_leads || { doc: { url: $wc_load(document.URL), ref: $wc_load(document.referrer), search: $wc_load(location.search), hash: $wc_load(location.hash) } };
      (window.requestIdleCallback || function(cb){ window.setTimeout(cb, 1) })(function() {
        var s = document.createElement('script');
        s.src = '//s.ksrndkehqnwntyxlhgto.com/149173.js';
        document.head.appendChild(s);
      });
    </script>

    <SpeedInsights />
  </head>
  <body class={hideHeader ? '' : 'has-fixed-header'}>
    {!hideHeader && <SiteHeader active={pageId ?? undefined} theme={headerTheme} client:load />}
    <main>
      <slot />
    </main>
    {!hideFooter && <SiteFooter animatedBar={animatedBar} />}
    {showStickyCta && (
      <a href="/contact" class="rd-sticky-cta" aria-hidden="true">
        <span class="rd-sticky-cta-text">
          <span class="rd-sticky-cta-label">Claim your market</span>
          <span class="rd-sticky-cta-sub">One CAM firm per metro</span>
        </span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
    )}
    <!-- Scroll-reveal motion (src/lib/motion.ts), mobile enhancements (src/lib/mobile.ts), <dialog> modals (src/lib/dialog.ts) -->
    <script>
      import { initMotion } from '~/lib/motion';
      import { initMobile } from '~/lib/mobile';
      import { initDialogs } from '~/lib/dialog';
      import { initHeroMap } from '~/lib/hero-map';
      initMotion();
      initMobile();
      initDialogs();
      initHeroMap();
    </script>
  </body>
</html>
