---
import BaseLayout from '~/layouts/BaseLayout.astro';
import GetStartedPage, { GetStartedForm, GET_STARTED_FAQ } from '~/components/pages/GetStartedPage';
import { faqSchema } from '~/lib/schema';
// Title + description unchanged from the pre-redesign page (zero SEO regression).
// The page shell is static; only the lead form hydrates (it posts to /api/lead).
---
<BaseLayout
  title="Get Started — Claim Your Market | Alloy"
  description="Diagnostic intake for CAM operators. ZIP market check, portfolio sizing, and engine diagnosis — before the 30-minute strategic review call."
  pageId="system"
  pageSchema={faqSchema(GET_STARTED_FAQ)}
>
  <GetStartedPage>
    <GetStartedForm client:load />
  </GetStartedPage>
</BaseLayout>
