---
import BaseLayout from '~/layouts/BaseLayout.astro';
import HeroStatic from '~/components/sections/HeroStatic.astro';
import HomePage from '~/components/pages/HomePage';
import HeroCard from '~/components/modules/HeroCard';
import NetworkLeadsChart from '~/components/modules/NetworkLeadsChart';
// Title + description unchanged from the pre-redesign page (zero SEO regression).
---
<BaseLayout
  title="Alloy — One growth partner. Three engines. Exclusively CAM."
  description="Alloy engineers growth for CAM firms through three connected engines — BoardReach, BoardMatch, BoardRetain — run as one playbook with market exclusivity."
  pageId="home"
  animatedBar={true}
>
  <!--
    HeroStatic renders the h1 as pure static HTML (no island wrapper) so Chrome records LCP
    at HTML parse time. Only the hero outcomes card and the network-leads chart hydrate.
  -->
  <HeroStatic><HeroCard client:load /></HeroStatic>
  <HomePage>
    <NetworkLeadsChart slot="chart" client:visible />
  </HomePage>
</BaseLayout>
