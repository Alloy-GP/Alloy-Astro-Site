---
import BaseLayout from '~/layouts/BaseLayout.astro';
import HeroStatic from '~/components/sections/HeroStatic.astro';
import HomePage from '~/components/pages/HomePage';
import HeroMap from '~/components/modules/HeroMap';
import MetroCheck from '~/components/modules/MetroCheck';
import NetworkLeadsChart from '~/components/modules/NetworkLeadsChart';
import NewsletterSignup from '~/components/modules/NewsletterSignup';
// Title + description changed DELIBERATELY (client, 2026-10-01) to target "marketing for HOA management companies";
// previously "Alloy — One growth partner. Three engines. Exclusively CAM." (see CLAUDE.md › SEO rules).
---
<BaseLayout
  title="HOA Management Marketing Agency | Alloy Growth Partners"
  description="Alloy is the HOA management marketing agency: local SEO, AI search, proposals and board retention, run as one system for one CAM firm per metro."
  pageId="home"
  animatedBar={true}
>
  <!--
    HeroStatic renders the h1 as pure static HTML (no island wrapper) so Chrome records LCP
    at HTML parse time. The map hero is static too; only its metro check and the network-leads chart hydrate.
  -->
  <HeroStatic><HeroMap><MetroCheck client:load /></HeroMap></HeroStatic>
  <HomePage>
    <NetworkLeadsChart slot="chart" client:visible />
    <NewsletterSignup slot="newsletter" source="home-page" client:idle />
  </HomePage>
</BaseLayout>
