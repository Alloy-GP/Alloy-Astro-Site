---
// src/pages/collections/cost-of-delinquent-accounts.astro — /collections/cost-of-delinquent-accounts
// Collections content cluster, page 5 of 11 (docs/ops/collections-cluster.md): indexable, go-live 2026-10-20.
// Copy + links live in src/data/articles/cost-of-delinquent-accounts.ts; the route only wires layout, schema and robots.
// Gating is driven by `data.noindex`: clear it in the data file (and add the path to SITEMAP_ROUTES) to go live.
import BaseLayout from '~/layouts/BaseLayout.astro';
import ArticlePage from '~/components/rd/ArticlePage';
import { articlePageSchema } from '~/lib/article-page';
import { data } from '~/data/articles/cost-of-delinquent-accounts';
---
<BaseLayout
  title={data.title}
  description={data.description}
  pageId="resources"
  ogType="article"
  pageSchema={articlePageSchema(data)}
  {...(data.noindex ? { robots: 'noindex,follow' } : {})}
>
  <ArticlePage data={data} />
</BaseLayout>
