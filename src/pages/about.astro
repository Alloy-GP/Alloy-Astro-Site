---
import BaseLayout from '~/layouts/BaseLayout.astro';
import AboutPage from '~/components/pages/AboutPage';
import { SITE } from '~/config/site';
// Title + description unchanged from the pre-redesign page (zero SEO regression).
// Static page — no client directive. About lives in the footer, not the nav, so no pageId.
// Person schema for the three managing partners (names/roles mirror AboutPage; add sameAs profile URLs when the client supplies them).
const worksFor = { '@type': SITE.org.type, name: SITE.name, url: SITE.url };
const peopleLd = [
  { name: 'Skyler Nelson', jobTitle: 'Managing Partner, Marketing', image: `${SITE.url}/assets/team/skyler-nelson.jpg` },
  { name: 'Justin Guenther', jobTitle: 'Managing Partner, Learning & Development' },
  { name: 'Cameron Lange', jobTitle: 'Managing Partner, Executive' },
].map((p) => ({ '@context': 'https://schema.org', '@type': 'Person', ...p, worksFor, url: `${SITE.url}/about` }));
---
<BaseLayout
  title="About Alloy — Built by CAM operators, for CAM operators"
  description="Three CAM operators with 35+ years inside community association management. We built the agency we wished existed when we were inside."
  pageSchema={peopleLd}
>
  <AboutPage />
</BaseLayout>
