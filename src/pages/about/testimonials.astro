---
import BaseLayout from '~/layouts/BaseLayout.astro';
import TestimonialsPage from '~/components/pages/TestimonialsPage';
// Title + description unchanged from the pre-redesign page (zero SEO regression).
// Static page — no client directive. No pageId (lives in the footer, not the nav).
// VideoObject schema for the two Vimeo embeds (thumbnail/upload date/duration from Vimeo oEmbed, 2026-10-02).
const videoLd = [
  { name: 'A CAM company CEO on working with Alloy', description: 'The CEO of an Alloy partner management company on what changed after engaging Alloy Growth Partners.', embedUrl: 'https://player.vimeo.com/video/1131397045', thumbnailUrl: 'https://i.vimeocdn.com/video/2075421928-6b2bada52307cabcbb9269764399cd4ed4be30070251131b314f7bbf6a049151-d_1280', uploadDate: '2025-10-28', duration: 'PT2M58S' },
  { name: 'Jeff Harman, CMGT, on working with Alloy', description: 'Jeff Harman of CMGT on working with Alloy Growth Partners.', embedUrl: 'https://player.vimeo.com/video/1230353437?h=22399014d8', thumbnailUrl: 'https://i.vimeocdn.com/video/2205242198-444ca99feab936134d1c492e8dee6b6dc1453a3bf415011cf127aabe66832db5-d_1280', uploadDate: '2026-09-25', duration: 'PT5M5S' },
].map((v) => ({ '@context': 'https://schema.org', '@type': 'VideoObject', ...v, publisher: { '@type': 'Organization', name: 'Alloy Growth Partners', url: 'https://alloygp.co' } }));
---
<BaseLayout
  title="Testimonials: In their own words | Alloy"
  description="Real CAM operators share what changed when they partnered with Alloy. Video and written testimonials from firms using Reach, Match, and Retain."
  pageSchema={videoLd}
>
  <TestimonialsPage />
</BaseLayout>
