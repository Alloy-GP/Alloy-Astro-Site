---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FAQPage, { FAQ_ITEMS } from '~/components/pages/FAQPage';
import { faqSchema } from '~/lib/schema';
// Title + description unchanged from the pre-redesign page (zero SEO regression).
// FAQPage schema is generated from every rendered Q&A (plain-text answers).
// Static page — no client directive; answers are server-rendered.
---
<BaseLayout
  title="FAQ — HOA CAM Marketing & Growth — Alloy Growth Partners"
  description="How market exclusivity works, what BoardSuite tiers cost, why we only serve CAM, and everything else operators ask before signing on."
  pageSchema={faqSchema(FAQ_ITEMS)}
>
  <FAQPage />
</BaseLayout>
