---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServicePage from '~/components/rd/ServicePage';
import data from '~/data/services/annual-report-production';
import { faqSchema, breadcrumbSchema, serviceSchema } from '~/lib/schema';

// Title + description unchanged from the pre-redesign page (zero SEO regression).
const description = "Transform your CAM firm's annual report from a compliance packet into a retention asset. Designed reports, plain-English narrative, multi-channel delivery.";
const schema = [
  faqSchema(data.faq.items),
  serviceSchema({ name: data.name, description, url: data.href }),
  breadcrumbSchema([{ name: 'The System', href: '/services' }, { name: 'BoardRetain™', href: '/boardretain' }, { name: data.name, href: data.href }]),
];
---
<BaseLayout
  title="HOA Annual Report Production | BoardRetain™ | Alloy GP"
  description={description}
  pageId="system"
  pageSchema={schema}
>
  <ServicePage data={data} />
</BaseLayout>
