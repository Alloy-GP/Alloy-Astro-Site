---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServicePage from '~/components/rd/ServicePage';
import data from '~/data/services/reputation-management';
import { faqSchema, breadcrumbSchema, serviceSchema } from '~/lib/schema';

// Title + description unchanged from the pre-redesign page (zero SEO regression).
const description = "Protect and build your CAM firm's online reputation. Review monitoring, response management, and proactive reputation-building for HOA management companies.";
const schema = [
  faqSchema(data.faq.items),
  serviceSchema({ name: data.name, description, url: data.href }),
  breadcrumbSchema([{ name: 'The System', href: '/services' }, { name: 'BoardRetain™', href: '/boardretain' }, { name: data.name, href: data.href }]),
];
---
<BaseLayout
  title="HOA Reputation Management | BoardRetain™ | Alloy GP"
  description={description}
  pageId="system"
  pageSchema={schema}
>
  <ServicePage data={data} />
</BaseLayout>
