---
// src/pages/book-club.astro
// HOA Leader Book Club signup landing page, built from the site's rd-* system with the full site
// chrome (header + footer, like /contact). noindex, not in nav or the sitemap: shared by link with
// retreat attendees. The seats form (modules/BookClubForm.tsx) is the only island; it posts to
// /api/book-club and keeps id="ge-book-club" so one WhatConverts web-form registration covers this
// page and the worksheet's form on /cai-growth. BaseLayout hides the sticky "Claim your market"
// bar here (the page has its own CTA).
import BaseLayout from '~/layouts/BaseLayout.astro';
import BookClubPage from '~/components/pages/BookClubPage';
import BookClubForm from '~/components/modules/BookClubForm';
---
<BaseLayout
  title="HOA Leader Book Club | Alloy Growth Partners"
  description="One hour with people who run management companies. Nothing to read, nothing to prep. Save your seat, and seats for the senior leaders you are developing."
  robots="noindex,follow"
>
  <BookClubPage>
    <BookClubForm client:load />
  </BookClubPage>
</BaseLayout>
