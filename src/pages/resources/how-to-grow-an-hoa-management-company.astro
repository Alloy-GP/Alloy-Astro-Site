---
// src/pages/resources/how-to-grow-an-hoa-management-company.astro — /resources/how-to-grow-an-hoa-management-company
// Collections content cluster, page 8 of 11 (docs/ops/collections-cluster.md): gated until go-live 2026-10-27.
// Copy + links live in src/data/articles/how-to-grow-an-hoa-management-company.ts; the route only wires layout, schema and robots.
// Gating is driven by `data.noindex`: clear it in the data file (and add the path to SITEMAP_ROUTES) to go live.
import BaseLayout from '~/layouts/BaseLayout.astro';
import ArticlePage from '~/components/rd/ArticlePage';
import { articlePageSchema } from '~/lib/article-page';
import { data } from '~/data/articles/how-to-grow-an-hoa-management-company';
---
<BaseLayout
  title={data.title}
  description={data.description}
  pageId="resources"
  ogType="article"
  pageSchema={articlePageSchema(data)}
  {...(data.noindex ? { robots: 'noindex,follow' } : {})}
>
  <ArticlePage data={data} />
</BaseLayout>
