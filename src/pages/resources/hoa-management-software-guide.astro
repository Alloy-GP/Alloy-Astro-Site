---
// src/pages/resources/hoa-management-software-guide.astro
// Pillar guide targeting the "hoa management software" keyword cluster
// (vol 1,100 head, KD 2, opp 1,078). Funnels into /boardsuite.
//
// Title + description unchanged from the pre-redesign page (zero SEO regression).
// JSON-LD (Article + BreadcrumbList + FAQPage) now flows through BaseLayout's
// pageSchema prop instead of inline <script> tags in <body>. FAQPage text is
// the same answer copy readers see on the page.
import BaseLayout from '~/layouts/BaseLayout.astro';
import HOASoftwareGuide, { hoaSoftwareFAQ } from '~/components/pages/HOASoftwareGuide';
import { articleSchema, breadcrumbSchema, faqSchema } from '~/lib/schema';

const path = '/resources/hoa-management-software-guide';
const pageTitle = 'HOA Management Software: 2026 Buyer’s Guide for CAM Firms';
const pageDesc = 'The 2026 guide to HOA management software for CAM firms — what to evaluate, pricing, integrations, and how to roll it out without disrupting boards.';

const article = {
  ...articleSchema({
    headline: 'HOA Management Software: 2026 Buyer’s Guide for CAM Firms',
    description: pageDesc,
    url: path,
    datePublished: '2026-05-13',
    dateModified: '2026-09-23',
  }),
  inLanguage: 'en-US',
  about: [
    { '@type': 'Thing', name: 'HOA management software' },
    { '@type': 'Thing', name: 'Community association management' },
  ],
};

const crumbs = breadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Resources', href: '/resources' },
  { name: 'HOA Management Software Guide', href: path },
]);
---
<BaseLayout
  title={pageTitle}
  description={pageDesc}
  pageId="resources"
  ogType="article"
  pageSchema={[article, crumbs, faqSchema(hoaSoftwareFAQ)]}
>
  <HOASoftwareGuide />
</BaseLayout>
