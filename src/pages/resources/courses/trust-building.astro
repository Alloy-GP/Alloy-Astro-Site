---
// /resources/courses/trust-building — the single-page trust-building guide
// (absorbs the 10 lessons + quiz; each section id = the old lesson slug).
// Title + description unchanged from the pre-redesign page (zero SEO regression).
// Static page; only the knowledge check hydrates (client:visible).
import BaseLayout from '~/layouts/BaseLayout.astro';
import CourseTrustBuildingPage from '~/components/pages/CourseTrustBuildingPage';
import TrustBuildingQuiz from '~/components/modules/TrustBuildingQuiz';
import { courseSchema, breadcrumbSchema } from '~/lib/schema';
import { SITE } from '~/config/site';

const path = '/resources/courses/trust-building';
const description = 'Learn how reviews, testimonials, and case studies help CAM companies win more boards. Free micro-course from Alloy Growth Partners.';

const baseCourse = courseSchema({
  name: 'Trust Building for CAM Firms: Reviews, Testimonials & Case Studies',
  description,
  url: path,
});

// Extra Course fields carried over from the pre-redesign schema.
const course = {
  ...baseCourse,
  educationalLevel: 'Beginner',
  inLanguage: 'en',
  courseMode: 'online',
  hasCourseInstance: {
    ...baseCourse.hasCourseInstance,
    instructor: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
};

const crumbs = breadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Resources', href: '/resources' },
  { name: 'Courses', href: '/resources/courses' },
  { name: 'Trust Building for CAM Firms', href: path },
]);
---
<BaseLayout
  title="Trust Building for CAM Firms | Alloy Courses"
  description={description}
  pageId="resources"
  pageSchema={[course, crumbs]}
>
  <CourseTrustBuildingPage>
    <TrustBuildingQuiz client:visible />
  </CourseTrustBuildingPage>
</BaseLayout>
