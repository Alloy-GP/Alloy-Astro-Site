---
// /resources/ai-search-for-cam — URL MOVE from /resource-hub/ai-search-for-cam (restored as a standalone
// article 2026-10-01; the sitemap spec had folded it into /property-management-seo, the client wants every
// real article kept). Title, description, ogType and Article schema carried over from
// src/pages/resource-hub/ai-search-for-cam.astro on main (zero SEO regression); schema URL updated.
import BaseLayout from '~/layouts/BaseLayout.astro';
import AISearchArticle from '~/components/pages/AISearchArticle';
import { articleSchema, breadcrumbSchema } from '~/lib/schema';
import { SITE } from '~/config/site';

const path = '/resources/ai-search-for-cam';
const title = 'How CAM Firms Win in AI Search. Alloy Resource Hub';
const description = "ChatGPT, Perplexity, Gemini, and Google AI Overviews now answer board questions before your website does. Here's how to be the answer they cite.";

const article = {
  ...articleSchema({
    headline: 'How CAM Firms Win in AI Search',
    description,
    url: path,
    datePublished: '2026-05-04',
    dateModified: '2026-10-02',
    image: '/assets/resources/ai-search-for-cam-og.jpg',
  }),
  url: new URL(path, SITE.url).toString(),
  // Named author carried over from the original schema.
  author: {
    '@type': 'Person',
    name: 'Skyler Nelson',
    jobTitle: 'Managing Partner',
    worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
};

const crumbs = breadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Resources', href: '/resources' },
  { name: 'AI search for CAM', href: path },
]);
---
<BaseLayout
  ogImage="/assets/resources/ai-search-for-cam-og.jpg"
  title={title}
  description={description}
  pageId="resources"
  ogType="article"
  pageSchema={[article, crumbs]}
>
  <AISearchArticle />
</BaseLayout>
