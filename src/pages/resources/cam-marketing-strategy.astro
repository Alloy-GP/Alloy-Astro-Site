---
// /resources/cam-marketing-strategy — URL MOVE from /resource-hub/cam-marketing-strategy.
// Title, description, ogType and Article schema carried over from
// src/pages/resource-hub/cam-marketing-strategy.astro (zero SEO regression);
// schema URL updated to the new path, built via ~/lib/schema.
import BaseLayout from '~/layouts/BaseLayout.astro';
import MarketingStrategyArticle from '~/components/pages/MarketingStrategyArticle';
import { articleSchema, breadcrumbSchema } from '~/lib/schema';
import { SITE } from '~/config/site';

const path = '/resources/cam-marketing-strategy';
const title = 'The CAM Marketing Strategy That Actually Compounds — Alloy';
const description = "Why 'do more marketing' fails and what an engineered, system-first growth strategy looks like for CAM firms over 18 months.";

const article = {
  ...articleSchema({
    headline: 'The CAM Marketing Strategy That Actually Compounds',
    description,
    url: path,
    datePublished: '2026-05-04',
    dateModified: '2026-09-23',
  }),
  url: new URL(path, SITE.url).toString(),
  // Named author carried over from the original schema.
  author: {
    '@type': 'Person',
    name: 'Skyler Nelson',
    jobTitle: 'Managing Partner',
    worksFor: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
};

const crumbs = breadcrumbSchema([
  { name: 'Home', href: '/' },
  { name: 'Resources', href: '/resources' },
  { name: 'CAM marketing strategy', href: path },
]);
---
<BaseLayout
  title={title}
  description={description}
  pageId="resources"
  ogType="article"
  pageSchema={[article, crumbs]}
>
  <MarketingStrategyArticle />
</BaseLayout>
