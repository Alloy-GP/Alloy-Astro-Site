---
import BaseLayout from '~/layouts/BaseLayout.astro';
import HubPage from '~/components/rd/HubPage';
import data from '~/data/hubs/boardmatch';
import { breadcrumbSchema, faqSchema } from '~/lib/schema';
---
<BaseLayout
  title="BoardMatch™: Win More HOA Management Proposals | Alloy GP"
  description="BoardMatch is the close engine for CAM firms: proposals, RFP responses, sales messaging, and fractional BD that turn conversations into contracts."
  pageId="system"
  pageSchema={[faqSchema(data.faq!.items), breadcrumbSchema([{ name: 'The System', href: '/services' }, { name: 'BoardMatch™', href: '/boardmatch' }])]}
>
  <HubPage data={data} />
</BaseLayout>
