---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServicePage from '~/components/rd/ServicePage';
import data from '~/data/services/sales-messaging';
import { faqSchema, breadcrumbSchema, serviceSchema } from '~/lib/schema';

// Title + description unchanged from the pre-redesign page (zero SEO regression).
const description = 'We rebuild your HOA management sales messaging — 30-second answer, differentiation, proof, objection responses — into one story your team tells consistently.';
const schema = [
  faqSchema(data.faq.items),
  serviceSchema({ name: data.name, description, url: data.href }),
  breadcrumbSchema([{ name: 'The System', href: '/services' }, { name: 'BoardMatch™', href: '/boardmatch' }, { name: data.name, href: data.href }]),
];
---
<BaseLayout
  title="Sales Messaging for HOA Management Companies | Alloy GP"
  description={description}
  pageId="system"
  pageSchema={schema}
>
  <ServicePage data={data} />
</BaseLayout>
