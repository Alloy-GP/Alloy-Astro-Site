import PricingPage, { PRICING_FAQ } from '~/components/pages/PricingPage';
import { faqSchema } from '~/lib/schema';
// Title + description unchanged from the pre-redesign page (zero SEO regression).
// FAQPage schema is built from the same items rendered in the visible FAQ.
---
<BaseLayout
  title="Pricing — BoardSuite Plans | Alloy GP"
  description="Transparent, all-in pricing for CAM growth. Three BoardSuite tiers — Foundation, Growth, Scale — one CAM firm per market. No rate cards, no surprise fees."
