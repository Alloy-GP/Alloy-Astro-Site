---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServicePage from '~/components/rd/ServicePage';
import data from '~/data/services/property-management-seo';
import { faqSchema, breadcrumbSchema, serviceSchema } from '~/lib/schema';

// Title + description unchanged from the pre-redesign page (zero SEO regression).
const description = 'HOA management SEO: local search, the map pack, GEO and AI visibility for CAM companies. Get cited by ChatGPT, Perplexity, Gemini and Google AI Overviews.';
const schema = [
  faqSchema(data.faq.items),
  serviceSchema({ name: 'HOA Management SEO', description, url: data.href }),
  breadcrumbSchema([{ name: 'The System', href: '/services' }, { name: 'BoardReach™', href: '/boardreach' }, { name: data.name, href: data.href }]),
];
---
<BaseLayout
  title="HOA Management SEO: Google, Map Pack & AI Answers | Alloy"
  description={description}
  pageId="system"
  pageSchema={schema}
>
  <ServicePage data={data} />
</BaseLayout>
