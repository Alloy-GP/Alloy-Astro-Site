---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServicePage from '~/components/rd/ServicePage';
import data from '~/data/services/email-marketing';
import { faqSchema, breadcrumbSchema, serviceSchema } from '~/lib/schema';

// Title + description unchanged from the pre-redesign page (zero SEO regression).
const description = 'Done-for-you email marketing built for CAM firms. Drip sequences, board nurture campaigns, and newsletter systems that keep your firm top of mind.';
const schema = [
  faqSchema(data.faq.items),
  serviceSchema({ name: 'Email Marketing', description, url: data.href }),
  breadcrumbSchema([{ name: 'The System', href: '/services' }, { name: 'BoardReach™', href: '/boardreach' }, { name: data.name, href: data.href }]),
];
---
<BaseLayout
  title="HOA Email Marketing for CAM Companies | Alloy GP"
  description={description}
  pageId="system"
  pageSchema={schema}
>
  <ServicePage data={data} />
</BaseLayout>
