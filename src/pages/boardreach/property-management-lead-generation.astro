---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServicePage from '~/components/rd/ServicePage';
import data from '~/data/services/property-management-lead-generation';
import { faqSchema, breadcrumbSchema, serviceSchema } from '~/lib/schema';

// Title + description unchanged from the pre-redesign page (zero SEO regression).
const description = "The lead-generation system built for CAM firms — not 'more marketing.' Five named channels, scored leads, briefed handoffs, and a CFO-readable pipeline. Live in 60 days.";
const schema = [
  faqSchema(data.faq.items),
  serviceSchema({ name: 'Lead Generation', description, url: data.href }),
  breadcrumbSchema([{ name: 'The System', href: '/services' }, { name: 'BoardReach™', href: '/boardreach' }, { name: data.name, href: data.href }]),
];
---
<BaseLayout
  title="Property Management Lead Generation | Alloy GP"
  description={description}
  pageId="system"
  pageSchema={schema}
>
  <ServicePage data={data} />
</BaseLayout>
