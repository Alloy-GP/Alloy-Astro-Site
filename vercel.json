{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "alloy-astro-site.vercel.app"
        }
      ],
      "destination": "https://alloygp.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "alloy-astro-site.vercel.app"
        }
      ],
      "destination": "https://alloygp.co/:path*",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    },
    {
      "source": "/history/:path*",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/courses/outsmarting-ai-search-how-micro-courses-drive-clicks-credibility-conversions/:path*",
      "destination": "/resources/courses",
      "permanent": true
    },
    {
      "source": "/account-login",
      "destination": "https://growth.alloygp.co/",
      "permanent": true
    },
    {
      "source": "/account-login/",
      "destination": "https://growth.alloygp.co/",
      "permanent": true
    },
    {
      "source": "/learn/:path*",
      "destination": "/resources/courses",
      "permanent": true
    },
    {
      "source": "/product/:path*",
      "destination": "/pricing",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon-48.png|favicon-96.png|apple-touch-icon.png|icon-192.png|icon-512.png|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
